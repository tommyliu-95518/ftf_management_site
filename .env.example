# Paddle Billing
# Client-side token from Paddle Dashboard → Developer Tools → Authentication
VITE_PADDLE_CLIENT_TOKEN=test_xxx
# sandbox | production
VITE_PADDLE_ENVIRONMENT=sandbox

# Price IDs (Dashboard → Catalog → Prices)
# pro_1 → Pro Monthly
VITE_PADDLE_PRICE_PRO_MONTHLY=pri_xxx
# pro_2 → Pro Yearly
VITE_PADDLE_PRICE_PRO_YEARLY=pri_xxx

# Server-only: used by /api/paddle/webhook to mark the matching Supabase account Pro.
# Never prefix these with VITE_ — they must not ship to the browser.
PADDLE_WEBHOOK_SECRET=pdl_ntf_xxx
PADDLE_API_KEY=pdl_apikey_xxx
PADDLE_ENVIRONMENT=sandbox
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PUBLIC_SITE_URL=https://your-management-site.example.com

# NOWPayments crypto checkout (server-only)
# Store Settings → API key, IPN secret, optional public key
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret
NOWPAYMENTS_PUBLIC_KEY=your-nowpayments-public-key
# Set true to use https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_SANDBOX=true

